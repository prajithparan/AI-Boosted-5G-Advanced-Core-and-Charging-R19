# Generated by scripts/gen-lab-pki.sh -- regenerable dev-only lab certs/keys, not secrets worth
# version-controlling.
/certs/

# Fetched by simulators/ransim/fetch-and-build.sh -- AGPL-3.0 UERANSIM source + build output,
# not vendored into this repo. See docs/DECISIONS.md ADR-0016.
/simulators/ransim/vendor/
/simulators/ransim/logs/

# P4.8/ADR-0074: nfs/chf/training/train_quota_sizing.py's own venv, local MLflow tracking DB, and
# trained model artifacts -- regenerable, not vendored (same "not a secret, just regenerable dev
# output" reasoning as /certs/ above). Real, disclosed: this means a fresh checkout has NO trained
# model until someone actually runs the training script -- CHF_AI_QUOTA_SIZING_ENABLED defaults to
# false for exactly this reason, not silently degrading a "should be working" feature.
nfs/chf/training/.venv/
nfs/chf/training/mlflow.db
nfs/chf/training/models/
nfs/chf/training/mlruns/

# Conformance round-trip samples. The test writes these to
# build/tests/conformance/samples (SBI_CONFORMANCE_SAMPLES_DIR, set by CMake); running the test
# binary directly from the repo root instead falls back to "." and drops them here, which is how
# they were committed once already.
/guami.json
/nftype_unknown.json

# ETSI deliverables (TS PDFs/text) may not be redistributed -- specs/etsi/SOURCES.md, tools/specs/fetch_etsi_specs.py
specs/etsi/*.pdf
specs/etsi/*.txt

# ADR-0369: nfs/nwdaf/training/train_nf_load.py's own venv and MLflow tracking DB.
nfs/nwdaf/training/.venv/
nfs/nwdaf/training/mlflow.db
nfs/nwdaf/training/mlruns/
nfs/nwdaf/training/runs/
