{
  "permissions": {
    "deny": [
      "Read(./certs/**)",
      "Read(./simulators/ransim/vendor/**)",
      "Read(./gui/web/node_modules/**)",
      "Read(./docs/benchmark-*/**)",
      "Read(./.claude/worktrees/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/trim-build-output.sh"
          }
        ]
      }
    ]
  }
}
