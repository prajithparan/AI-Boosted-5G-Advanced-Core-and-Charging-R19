      "type": "object",
      "properties": {
        "tp:VLANID": {
          "type": "array",
          "items": {
            "$ref": "ts_103280_2017_07#/$defs/VLANID"
          },
          "minItems": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RCSPolicyCriteria": {
      "type": "object",
      "properties": {
        "tp:CommunicationServiceID": {
          "$ref": "ts_103280_2017_07#/$defs/ShortString"
