    "ListOfTrafficCriteria": {
      "type": "object",
      "properties": {
        "tp:Criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrafficCriteria"
          },
          "minItems": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "TrafficCriteria": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tp:IPPolicyCriteria": {
