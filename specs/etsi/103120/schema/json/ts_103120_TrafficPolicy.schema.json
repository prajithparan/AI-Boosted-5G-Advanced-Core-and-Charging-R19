    "ActionParameters": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tp:TruncateActionParameters": {
              "$ref": "#/$defs/TruncateActionParameters"
            }
          },
          "required": [
            "tp:TruncateActionParameters"
          ]
        }
      ]
    },
    "TruncateActionParameters": {
      "type": "object",
      "properties": {
        "tp:NumberOfOctets": {
          "type": "integer",
          "minimum": 0
